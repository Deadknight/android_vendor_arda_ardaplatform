# ARDA_PERSISTENT_CERT_STORAGE_INIT_V1_2
on post-fs-data
    mkdir /data/local/arda 0700 root root
    mkdir /data/local/arda/aap-key-update 0700 root root
    mkdir /data/local/arda/aap-certs 0700 root root
    restorecon_recursive /data/local/arda

service arda-connectivityd /system/bin/sh /product/bin/arda-connectivity-supervisor
    class late_start
    user root
    group root system shell bluetooth wifi inet
    seclabel u:r:shell:s0
    disabled

on property:sys.boot_completed=1
    start arda-connectivityd
