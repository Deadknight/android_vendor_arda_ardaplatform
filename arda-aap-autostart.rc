service arda_aap_session /system/bin/sh /product/bin/arda-aap-autostart
    class late_start
    user root
    group root system shell bluetooth wifi inet input graphics audio camera
    seclabel u:r:su:s0
    disabled
    restart_period 2

# Recovery triggers for later AOAP transitions. Initial boot prewarm is owned
# by arda-hw-encoder-mapper-bind.rc so the custom mapper is active first.
on property:sys.usb.state=accessory
    start arda_aap_session

on property:sys.usb.state=accessory,adb
    start arda_aap_session

on property:sys.usb.config=accessory
    start arda_aap_session

on property:sys.usb.config=accessory,adb
    start arda_aap_session
